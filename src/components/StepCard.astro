---
export interface Props {
  number: string | number;
  title: string;
  description: string;
  image: string;
  badgeText?: string; // Шинээр нэмсэн prop (заавал биш, өгөөгүй үед "Алхам" гэж харагдана)
}

const { number, title, description, image, badgeText = "Алхам" } = Astro.props;
---

<!-- h-full ашигласнаар карт тухайн зайг бүтэн эзэлнэ -->
<div class="bg-white rounded-2xl border border-gray-100 shadow-lg flex flex-col h-full">
  
  <!-- Зураг болон дээр нь давхарласан шошго -->
  <div class="relative w-full h-64 bg-gray-100 flex-shrink-0 ">
    <img src={image} alt={title} class="w-full h-full object-cover" />
    
    <!-- Шар шошго (Гаднаас ирсэн badgeText-ийг харуулна) -->
    <div class="absolute -top-6 left-4 bg-amber-500 text-white font-bold px-4 py-2 rounded-xl shadow-md flex items-center gap-2 z-10">
      <span>{badgeText}</span>
      <span class="bg-white text-amber-600 px-2 py-0.5 rounded-lg text-sm">{number}</span>
    </div>
  </div>

  <!-- Гарчиг болон тайлбар -->
  <div class="p-6 flex flex-col flex-1 justify-between">
    <h3 class="text-xl font-bold text-gray-900 mb-2">{title}</h3>
    <p class="text-gray-600 text-sm leading-relaxed">{description}</p>
  </div>

</div>

