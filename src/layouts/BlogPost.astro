---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Sidebar from '../components/Sidebar.astro';
import CallToActionBanner from '../components/CallToActionBanner.astro'
import FloatingBanner from '../components/FloatingBanner.astro'
// import Image from 'astro/components/Image.astro';
import ArticleSchema from '../components/ArticleSchema.astro';
// Props-оор ирж буй нийтлэлийн өгөгдөл (мөн Astro.url-ээс slug-ийг автоматаар салгаж авна)
const props = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags, headings, readingTime } = props;
console.log("HeroImage",heroImage)
// URL-ээс яг одоогийн нийтлэлийн slug-ийг олж авах (Жишээ нь: /blog/minii-niitlel/ -> minii-niitlel)
const currentPath = Astro.url.pathname;
const currentSlug = currentPath.split('/').filter(Boolean).pop();

// 1. Бүх нийтлэлийг авах
const allPosts = await getCollection('blog');

// 2. Төстэй нийтлэлүүдийг шүүх логик
const relatedPosts = allPosts.filter((post) => {
    // Өөрийнх нь ID болон одоогийн URL-ийн slug-тай таарч байвал хасна
    if (post.id === currentSlug || post.data.title === title) return false;
    
    // Хэрэв тухайн нийтлэлд tag байхгүй бол алгасна
    if (!tags || !post.data.tags) return false;
    
    // Одоогийн нийтлэлийн tag-уудаас дор хаяж нэг нь нөгөө нийтлэлтэй давхцаж байгаа эсэх
    return post.data.tags.some((tag: string) => tags.includes(tag));
}).slice(0, 3); // Хамгийн эхний 3-ыг л авах

// Тухайн одоогийн хуудасны URL-ийг авах
const currentUrl = Astro.url.href;
const encodedTitle = encodeURIComponent(title);
const encodedUrl = encodeURIComponent(currentUrl);

// Энийг нэмээд терминал эсвэл хөтчийн консол дээр юу гарч ирж байгааг хараарай
console.log("Бүх нийтлэл:", allPosts.length);
console.log("Одоогийн tag-ууд:", tags);
console.log("Олдсон төстэй нийтлэлүүд:", relatedPosts.length);
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<link rel="icon" href="/favicon.ico" />
		
		<!-- Open Graph (Сошиал хуваалтын тохиргоо) -->
		<meta property="og:site_name" content="Burzai Zar Blog" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title || "Бурзай-Зар Блог"} />
		<meta property="og:description" content={description || "Танд хэрэгтэй зарлал, мэдээлэл, зөвлөгөө"} />
		
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<!-- Зураг болон түүний хэмжээсүүд (Анхааруулгыг арилгах хэсэг) -->
		<meta property="og:image" content={new URL(heroImage || '/default-og-image.jpg', Astro.url)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter/X хуваалтад зориулсан -->
		<meta name="twitter:card" content="summary_large_image" />

		<!-- ========================================== -->
        <!-- ЭНД ARTICLE SCHEMA КОМПОНЕНТОО ЗУРАГТАЙ НЬ ХОЛБОЖ БАЙНА -->
        <!-- ========================================== -->
        {(() => {
            const schemaImage = typeof heroImage === 'object' && heroImage !== null && 'src' in heroImage
                ? (heroImage as { src: string }).src
                : (heroImage || '/default-og-image.jpg');
            
            const absoluteImageUrl = new URL(schemaImage, Astro.url).href;

            return (
                <ArticleSchema 
                    headline={title}
                    description={description || title}
                    image={absoluteImageUrl}
                    datePublished={pubDate ? new Date(pubDate).toISOString() : new Date().toISOString()}
                    dateModified={updatedDate ? new Date(updatedDate).toISOString() : (pubDate ? new Date(pubDate).toISOString() : new Date().toISOString())}
                    authorName="Burzai Zar Admin"
                    publisherName="Burzai Zar Blog"
                    publisherLogo={new URL('/android-chrome-192x192.png', Astro.url).href}
                    url={Astro.url.href}
                />
            );
        })()}
   </head>

	<body class="bg-white text-slate-900 antialiased flex flex-col min-h-screen">
		<Header />

		<!-- Нийтлэлийн дээр эсвэл доор буцах товч нэмэх нь -->
		
		<div class="max-w-[1200px] w-full mx-auto px-4 py-8 grid grid-cols-1 lg:grid-cols-3 gap-10">
    

    <!-- Зүүн талд: Нийтлэлийн үндсэн хэсэг (PC дээр 2 багана эзэлнэ) -->
    <main class="lg:col-span-2 w-full">
		<div class="max-w-720px mx-auto mb-4  px-4 pt-6">
			<a href="/blog" class="inline-flex items-center text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors">
				← Буцах
			</a>
		</div>
        <article class="w-full" data-pagefind-body>
            <!-- Hero Зураг -->
            {heroImage && (
                <div class="w-full mb-8">
                    <Image 
                        width={720} 
                        height={360} 
                        src={heroImage} 
                        alt={title} 
                        class="w-full h-auto rounded-lg shadow-lg object-cover" 
                    />
                </div>
            )}
			<!-- {heroImage && (
				<img 
					src={heroImage} 
					alt="Blog hero image" 
					class="rounded-xl w-full h-auto object-cover" 
				/>
			)} -->
            
            <!-- Гарчиг болон огноо -->
            <div class="text-center mb-8 pb-6 border-b border-slate-200">
                <div class="text-slate-500 mb-2 text-sm">
                    <!-- <FormattedDate date={pubDate} /> -->
					 <!-- Огнооны хажууд эсвэл доор нь харуулах -->
				<div class="text-slate-500 mb-2 text-sm flex items-center justify-center gap-3">
					<span><FormattedDate date={pubDate} /></span>
					<span>•</span>
					<span>📖 Унших хугацаа: {readingTime || 3} минут</span>
				</div>
                    {updatedDate && (
                        <div class="italic">
                            Last updated on <FormattedDate date={updatedDate} />
                        </div>
                    )}
                </div>
                <h1 class="text-4xl font-bold tracking-tight text-slate-900 leading-tight mb-2">{title}</h1>
                
                <div class="text-sm font-semibold text-blue-600 uppercase mb-2">
                    <a href={`/blog/category/${Astro.props.category}`}>
                       【{Astro.props.category}】
                    </a>
                </div>
                
                <div class="flex flex-wrap gap-2 mt-4 justify-center">
                  {Astro.props.tags?.map((tag: string) => (
                    <a href={`/blog/tags/${tag}`} class="bg-slate-100 px-2 py-1 rounded text-sm hover:bg-blue-100">
                      #{tag}
                    </a>
                  ))}
                </div>
            </div>

			{headings && headings.length > 0 && (
				<details class="bg-slate-50 border border-slate-200 rounded-xl p-4 mb-6">
					<summary class="font-bold cursor-pointer text-slate-700">Агуулгын хураангуй</summary>
					<nav>
						{/* <h2 class="text-lg font-bold text-slate-900 mb-4">Гарчиг</h2> */}
						<!-- Огнооны хажууд эсвэл доор нь харуулах -->
						<ul class="space-y-2 text-sm">
							{headings.map((heading) => (
								<li class={`list-none ${heading.depth === 3 ? 'pl-4' : ''}`}>
									<a 
										href={`#${heading.slug}`} 
										class="text-slate-600 hover:text-blue-600 transition-colors block"
									>
										{heading.text}
									</a>
								</li>
							))}
						</ul>
					</nav>
				</details>
    
)}

            <!-- Нийтлэлийн үндсэн контент (Markdown) -->
            <!-- <div class="space-y-6 text-lg leading-relaxed text-slate-700 [&>h2]:text-2xl [&>h2]:font-bold [&>h2]:text-slate-900 [&>h2]:mt-8 [&>h2]:mb-4 [&>h3]:text-xl [&>h3]:font-bold [&>h3]:text-slate-900 [&>h3]:mt-6 [&>h3]:mb-3 [&>p]:mb-4 [&>ul]:list-disc [&>ul]:pl-6 [&>ul]:space-y-2 [&>ol]:list-decimal [&>ol]:pl-6 [&>ol]:space-y-2 [&>blockquote]:border-l-4 [&>blockquote]:border-blue-600 [&>blockquote]:pl-4 [&>blockquote]:italic [&>blockquote]:text-slate-600">
                <slot />
            </div> -->
			<!-- Нийтлэлийн үндсэн контент (Markdown) -->
			<div class="space-y-6 text-base md:text-lg leading-relaxed text-slate-700 
				[&>h2]:text-xl md:[&>h2]:text-2xl [&>h2]:font-bold [&>h2]:text-slate-900 [&>h2]:mt-8 [&>h2]:mb-4 
				[&>h3]:text-lg md:[&>h3]:text-xl [&>h3]:font-bold [&>h3]:text-slate-900 [&>h3]:mt-6 [&>h3]:mb-3 
				[&>p]:mb-4 
				[&>ul]:list-disc [&>ul]:pl-6 [&>ul]:space-y-2 
				[&>ol]:list-decimal [&>ol]:pl-6 [&>ol]:space-y-2 
				[&>blockquote]:border-l-4 [&>blockquote]:border-blue-600 [&>blockquote]:pl-4 [&>blockquote]:italic [&>blockquote]:text-slate-600">
				<slot />
			</div>
			<!-- Нийтлэлийн төгсгөлд баннер оруулах -->
			<CallToActionBanner />
        </article>

		<!-- Сошиал хуваалцах хэсэг -->
		<div class="mt-12 pt-6 border-t border-slate-200 flex flex-wrap items-center justify-between gap-4">
			<span class="text-sm font-semibold text-slate-700">Энэ нийтлэлийг хуваалцах:</span>
			
			<div class="flex items-center gap-3">
				<!-- Facebook дээр хуваалцах -->
				<a 
					href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`} 
					target="_blank" 
					rel="noopener noreferrer"
					class="bg-blue-50 text-blue-600 hover:bg-blue-100 px-3 py-2 rounded-lg text-sm font-medium transition-colors flex items-center gap-1.5"
				>
					<Image src="/snsicons/facebook.svg" alt="facebook" width={20} height={20}/>
				</a>

				<!-- X (Twitter) дээр хуваалцах -->
				<a 
					href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`} 
					target="_blank" 
					rel="noopener noreferrer"
					class="bg-slate-100 text-slate-800 hover:bg-slate-200 px-3 py-2 rounded-lg text-sm font-medium transition-colors flex items-center gap-1.5"
				>
					<Image src="/snsicons/x.svg" alt="x" width={16} height={16}/>
				</a>

				<!-- LinkedIn дээр хуваалцах -->
				<a 
					href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodedUrl}&title=${encodedTitle}`} 
					target="_blank" 
					rel="noopener noreferrer"
					class="bg-blue-50 text-blue-700 hover:bg-blue-100 px-3 py-2 rounded-lg text-sm font-medium transition-colors flex items-center gap-1.5"
				>
					<Image src="/snsicons/LinkedIn.webp" alt="LinkedIn" width={20} height={20}/>
				</a>

				<!-- Линк хуулж авах товч (JavaScript-тэй) -->
				<button 
					onclick={`navigator.clipboard.writeText('${currentUrl}'); alert('Линк хуулагдлаа!');`}
					class="bg-slate-100 text-slate-700 hover:bg-slate-200 px-3 py-2 rounded-lg text-sm font-medium transition-colors cursor-pointer"
				>
					🔗 Хуулах
				</button>
			</div>
		</div>
    </main>

    <!-- Баруун талд: Sidebar (PC дээр 1 багана эзэлнэ) -->
    <aside class="w-full">
        <div class="sticky top-8">
            <Sidebar />
			
        </div>
    </aside>

</div>
		<!-- Нийтлэлийн дээр эсвэл доор буцах товч нэмэх нь -->
		<div class="max-w-720px mx-auto px-4 pt-6">
			<a href="/blog" class="inline-flex items-center text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors">
				← Буцах 
			</a>
		</div>
		
		<!-- 4. Дизайн хэсэг (Tailwind CSS ашигласан жишээ) -->
{relatedPosts.length > 0 && (
    <section class="max-w-720px mx-auto px-4 mt-16 pt-8 border-t border-slate-200 mb-8">
        <h3 class="text-xl font-bold text-slate-900 mb-6">Төстэй нийтлэлүүд</h3>
        
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            {relatedPosts.map((post) => {
                // Файлын өргөтгөлийг арилгаж цэвэр ID авах (жишээ нь: first-post.md -> first-post)
                const cleanId = post.id.replace(/\.(md|mdx)$/, '');
                const postUrl = `/blog/${cleanId}/`;
                
                // Зургийн эх сурвалжийг зөвөөр авах (обьект эсвэл string байхаас үл хамааран)
                const imageSrc = typeof post.data.heroImage === 'object' && post.data.heroImage !== null 
                    ? post.data.heroImage.src 
                    : post.data.heroImage;

                return (
                    <a href={postUrl} class="group block h-full">
                        <div class="w-full max-w-[720px] h-48 mb-3 bg-slate-100 rounded-lg overflow-hidden">
                            {imageSrc ? (
                                <img 
                                    src={imageSrc} 
                                    alt={post.data.title}
                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
                                />
                            ) : (
                                <div class="w-full h-full flex items-center justify-center text-slate-400 text-sm">
                                    Зураггүй
                                </div>
                            )}
                        </div>
                        
                        <h4 class="text-sm font-semibold text-slate-900 group-hover:text-blue-600 line-clamp-2">
                            {post.data.title}
                        </h4>
                    </a>
                );
            })}
        </div>
    </section>
)}
		<Footer />
		<!-- Гар утасны хөвөгч баннер -->
        <FloatingBanner />
	</body>
</html>