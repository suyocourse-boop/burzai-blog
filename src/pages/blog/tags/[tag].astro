---
// src/pages/blog/tags/[tag].astro
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  
  // Нийтлэл бүрийн тагуудыг цуглуулж давхардалгүй болгох
  const allTags = [...new Set(posts.flatMap((p) => p.data.tags || []))];

  return allTags.map((tag) => {
    const filteredPosts = posts.filter((p) => p.data.tags?.includes(tag));
    return {
      params: { tag },
      props: { posts: filteredPosts, tag },
    };
  });
}

const { posts, tag } = Astro.props;
---

<html lang="mn">
  <head>
    <BaseHead title={`Таг: ${tag} - Бурзай-Зар Блог`} description={`${tag} тагтай нийтлэлүүд`} />
  </head>
  <body class="bg-slate-50 text-slate-900">
    <Header />
    <main class="max-w-[960px] mx-auto px-4 py-12">
      <h1 class="text-3xl font-bold mb-8">Шошго: <span class="text-blue-600">#{tag}</span></h1>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => (
          <a href={`/blog/${post.id}/`} class="bg-white p-6 rounded-xl border border-slate-200 hover:shadow-lg transition">
            <h2 class="font-bold text-lg mb-2">{post.data.title}</h2>
            <div class="text-xs text-slate-500"><FormattedDate date={post.data.pubDate} /></div>
          </a>
        ))}
      </div>
    </main>
    <Footer />
  </body>
</html>