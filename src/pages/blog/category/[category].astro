---
// src/pages/blog/category/[category].astro
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const categories = [...new Set(posts.map((p) => p.data.category).filter(Boolean))];

  return categories.map((category) => {
    const filteredPosts = posts.filter((p) => p.data.category === category);
    return {
      params: { category },
      props: { posts: filteredPosts, category },
    };
  });
}

const { posts, category } = Astro.props;
---

<html lang="mn">
	<head>
		<BaseHead title={`Ангилал: ${category} - Бурзай-Зар Блог`} description={`${category} ангилал дахь нийтлэлүүд`} />
	</head>

	<body class="bg-white text-slate-900 antialiased flex flex-col min-h-screen">
		<Header />

		<main class="w-full max-w-[960px] mx-auto px-4 py-12 flex-grow">
			<!-- Буцах товч -->
			<div class="mb-6">
				<a href="/blog" class="inline-flex items-center text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors">
					← Бүх нийтлэл рүү буцах
				</a>
			</div>

			<!-- Ангиллын гарчиг -->
			<div class="mb-10 pb-6 border-b border-slate-200">
				<span class="text-xs font-bold text-blue-600 uppercase tracking-widest">Ангилал</span>
				<h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 mt-1">
					【{category}】
				</h1>
				<p class="text-slate-600 mt-2">Энэ ангилалд нийт {posts.length} нийтлэл байна.</p>
			</div>

			<!-- Нийтлэлийн жагсаалт (Grid загвар) -->
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
				{posts.map((post) => {
					// Файлын өргөтгөлийг цэвэрлэх ID
					const cleanId = post.id.replace(/\.(md|mdx)$/, '');
					const postUrl = `/blog/${cleanId}/`;
					
					// Зураг шалгах
					const imageSrc = typeof post.data.heroImage === 'object' && post.data.heroImage !== null 
						? post.data.heroImage.src 
						: post.data.heroImage;

					return (
						<a href={postUrl} class="group flex flex-col bg-white border border-slate-200 rounded-xl overflow-hidden hover:shadow-lg transition-all duration-300">
							<!-- Зураг -->
							<div class="w-full h-40 bg-slate-100 overflow-hidden">
								{imageSrc ? (
									<img 
										src={imageSrc} 
										alt={post.data.title}
										class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
									/>
								) : (
									<div class="w-full h-full flex items-center justify-center text-slate-400 text-sm">
										Зураггүй
									</div>
								)}
							</div>

							<!-- Мэдээлэл -->
							<div class="p-5 flex flex-col flex-grow">
								<div class="text-xs text-slate-500 mb-2">
									<FormattedDate date={post.data.pubDate} />
								</div>
								<h2 class="text-base font-bold text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-2 mb-2">
									{post.data.title}
								</h2>
								<p class="text-slate-600 text-sm line-clamp-2 mt-auto">
									{post.data.description}
								</p>
							</div>
						</a>
					);
				})}
			</div>
		</main>

		<Footer />
	</body>
</html>