---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts'; // Хэрэย consts файл байгаа бол эсвэл шууд текст оруулж болно
import { getCollection } from 'astro:content';

// Бүх нийтлэлийг огноогоор нь эрэмбэлж авах
const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Хамгийн сүүлийн 1 нийтлэлийг онцлох (Hero post) болгож авах, үлдсэнийг нь жагсаалтад оруулах
const featuredPost = posts[0];
const recentPosts = posts.slice(1);
---

<!doctype html>
<html lang="mn">
    <head>
        <BaseHead title="Бурзай-Зар Блог | Мэдээлэл, Зөвлөгөө ба Зарагдах боломжууд" description="Танд хэрэгтэй зарлал, цаг үеийн мэдээлэл болон хэрэгцээт зөвлөгөөг нэг дор." />
    </head>
    <body class="bg-white text-slate-900 antialiased flex flex-col min-h-screen">
        <Header />

        <!-- Нүүр хуудасны үндсэн container -->
        <div class="max-w-[1200px] w-full mx-auto px-4 py-8">
            
            <!-- Grid систем: PC дээр 2/3 болон 1/3 багана, гар утас дээр босоо -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
                
                <!-- Зүүн тал: Нийтлэлүүд (2 багана эзэлнэ) -->
                <main class="lg:col-span-2 w-full">
                    
                    <!-- Welcome / Intro хэсэг -->
                    <div class="mb-10 pb-6 border-b border-slate-200">
                        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 mb-3">
                            Бурзай-Зар Блогт тавтай морилно уу! 👋
                        </h1>
                        <p class="text-lg text-slate-600 leading-relaxed">
                            Бид танд хамгийн хэрэгтэй зарлал, шинэ содон мэдээлэл болон бизнесийн болон амьдралын ухааны зөвлөгөөнүүдийг хүргэж байна.
                        </p>
                    </div>

                    <!-- 1. Онцлох нийтлэл (Featured Post - Хэрэв нийтлэл байвал) -->
                    {featuredPost && (
                        <div class="mb-12">
                            <h2 class="text-xl font-bold text-slate-900 mb-4 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-blue-600"></span> Онцлох нийтлэл
                            </h2>
                            <article class="bg-slate-50 border border-slate-200 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                                <a href={`/blog/${featuredPost.id.replace(/\.(md|mdx)$/, '')}/`} class="block group">
                                    {featuredPost.data.heroImage && (
                                        <div class="w-full h-84 overflow-hidden bg-slate-200">
                                            <img 
                                                src={typeof featuredPost.data.heroImage === 'object' ? featuredPost.data.heroImage.src : featuredPost.data.heroImage} 
                                                alt={featuredPost.data.title} 
                                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                            />
                                        </div>
                                    )}
                                    <div class="p-6">
                                        <div class="text-xs font-semibold text-blue-600 uppercase mb-2">
                                            {featuredPost.data.category || 'Мэдээ'}
                                        </div>
                                        <h3 class="text-2xl font-bold text-slate-900 group-hover:text-blue-600 mb-3 transition-colors">
                                            {featuredPost.data.title}
                                        </h3>
                                        <p class="text-slate-600 mb-4 line-clamp-2">
                                            {featuredPost.data.description}
                                        </p>
                                        <div class="text-sm text-slate-400">
                                            <FormattedDate date={featuredPost.data.pubDate} />
                                        </div>
                                    </div>
                                </a>
                            </article>
                        </div>
                    )}

                    <!-- 2. Бусад сүүлийн нийтлэлүүдийн жагсаалт -->
                    {recentPosts.length > 0 && (
                        <div>
                            <h2 class="text-xl font-bold text-slate-900 mb-6 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-blue-600"></span> Шинэ нийтлэлүүд
                            </h2>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                                {recentPosts.map((post) => {
                                    const cleanId = post.id.replace(/\.(md|mdx)$/, '');
                                    const imageSrc = typeof post.data.heroImage === 'object' && post.data.heroImage !== null 
                                        ? post.data.heroImage.src 
                                        : post.data.heroImage;

                                    return (
                                        <article class="bg-white border border-slate-200 rounded-lg overflow-hidden shadow-sm hover:shadow-md transition-shadow flex flex-col h-full">
                                            <a href={`/blog/${cleanId}/`} class="block group flex-grow flex flex-col">
                                                <div class="w-full h-40 bg-slate-100 overflow-hidden">
                                                    {imageSrc ? (
                                                        <img 
                                                            src={imageSrc} 
                                                            alt={post.data.title}
                                                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                                        />
                                                    ) : (
                                                        <div class="w-full h-full flex items-center justify-center text-slate-400 text-sm">
                                                            Зураггүй
                                                        </div>
                                                    )}
                                                </div>
                                                <div class="p-5 flex flex-col flex-grow justify-between">
                                                    <div>
                                                        <div class="text-xs font-semibold text-blue-600 uppercase mb-1">
                                                            {post.data.category || 'Мэдээ'}
                                                        </div>
                                                        <h3 class="text-base font-bold text-slate-900 group-hover:text-blue-600 line-clamp-2 mb-2">
                                                            {post.data.title}
                                                        </h3>
                                                    </div>
                                                    <div class="text-xs text-slate-400 mt-4">
                                                        <FormattedDate date={post.data.pubDate} />
                                                    </div>
                                                </div>
                                            </a>
                                        </article>
                                    );
                                })}
                            </div>
                        </div>
                    )}

                    {posts.length === 0 && (
                        <div class="text-center py-12 text-slate-500">
                            Тун удахгүй шинэ нийтлэлүүд нэмэгдэх болно.
                        </div>
                    )}

                </main>

                <!-- Баруун тал: Sidebar (Хайлт, Ангилал гэх мэт) -->
                <aside class="w-full">
                    <div class="sticky top-8">
                        <Sidebar />
                    </div>
                </aside>

            </div>
        </div>

        <Footer />
    </body>
</html>